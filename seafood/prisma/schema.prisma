// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 英国工程硕士项目
model Program {
  id                Int         @id @default(autoincrement())
  universityName    String      // 大学名称
  programName       String      // 项目名称
  department        String      // 学院
  degreeType        String      // 学位类型 MSc/MEng等
  duration          String      // 学制 1年/2年等
  originalSource    String      // 爬取的原始网页文本
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // 结构化录取要求
  requirements      Requirement[]
  evaluations       EvaluationResult[]

  @@index([universityName, programName])
}

// 项目录取要求
model Requirement {
  id                Int         @id @default(autoincrement())
  programId         Int
  type              RequirementType // 要求类型
  minimumValue      Float?      // 最低数值要求 比如GPA 80%
  requiredSubjects  String[]    // 要求的先修科目列表
  englishType       EnglishType? // 英语考试类型
  englishMinimum    Json?       // 英语最低分要求 比如 {overall:6.5, listening:6, ...}
  description       String      // 原始要求描述
  isMandatory       Boolean     @default(true) // 是否是硬性要求

  program           Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
}

// 申请人档案
model ApplicantProfile {
  id                Int         @id @default(autoincrement())
  gpa               Float       // 百分制GPA
  major             String      // 本科专业
  university        String      // 本科院校
  englishType       EnglishType // 英语考试类型
  englishScores     Json        // 英语成绩 比如 {overall:7.0, listening:6.5, ...}
  modules           Json        // 本科已修课程列表 [{name: "高等数学", score: 85, credit: 4}, ...]
  createdAt         DateTime    @default(now())

  evaluations       EvaluationResult[]
}

// 项目评估结果
model EvaluationResult {
  id                Int         @id @default(autoincrement())
  profileId         Int
  programId         Int
  status            EligibilityStatus // 评估结果
  missingRequirements String[]   // 未满足的要求列表（中文说明）
  score             Float?      // 匹配分数 0-100
  evaluatedAt       DateTime    @default(now())

  profile           ApplicantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  program           Program     @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([profileId, programId])
}

// 管理员用户
model AdminUser {
  id                Int         @id @default(autoincrement())
  username          String      @unique
  passwordHash      String
  createdAt         DateTime    @default(now())
}

// 枚举类型
enum RequirementType {
  GPA
  IELTS
  TOEFL
  PTE
  PREREQUISITE_MODULE // 先修课程
  OTHER
}

enum EnglishType {
  IELTS
  TOEFL
  PTE
  NONE
}

enum EligibilityStatus {
  ELIGIBLE     // 符合要求
  BORDERLINE   //  borderline 有机会
  NOT_ELIGIBLE // 不符合要求
}
